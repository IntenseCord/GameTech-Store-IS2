# Copia este archivo a .env y completa los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# --- Flask ---
# development | production
FLASK_ENV=development
# Clave secreta de la app. En development, si se omite, config.py genera una
# y la persiste en .dev_secret_key. En production es obligatoria.
SECRET_KEY=

# --- Base de datos ---
# Si se omite, se usa SQLite local (instance/gametech_store.db).
# Para Neon/PostgreSQL: postgresql://usuario:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Usuario administrador sembrado al iniciar la app ---
# Obligatorio: si falta, la app no arranca (ver database.py::seed_database).
ADMIN_PASSWORD=

# --- Correo saliente (verificación de cuenta, confirmación de compra, etc.) ---
# Ver instrucciones de configuración de Gmail SMTP + Contraseña de Aplicación
# en la documentación del proyecto.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Monitoreo de errores (opcional) ---
SENTRY_DSN=
APP_VERSION=1.0.0
